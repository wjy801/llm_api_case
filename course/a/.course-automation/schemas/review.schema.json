{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "overall_score",
    "dimension_scores",
    "hard_failures",
    "issues",
    "strengths",
    "revision_priority",
    "summary"
  ],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["pass", "revise"]
    },
    "overall_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "dimension_scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factual_accuracy",
        "explanatory_completeness",
        "beginner_readability",
        "structure_and_continuity",
        "boundary_accuracy",
        "expression_quality"
      ],
      "properties": {
        "factual_accuracy": {"type": "integer", "minimum": 0, "maximum": 40},
        "explanatory_completeness": {"type": "integer", "minimum": 0, "maximum": 20},
        "beginner_readability": {"type": "integer", "minimum": 0, "maximum": 15},
        "structure_and_continuity": {"type": "integer", "minimum": 0, "maximum": 10},
        "boundary_accuracy": {"type": "integer", "minimum": 0, "maximum": 10},
        "expression_quality": {"type": "integer", "minimum": 0, "maximum": 5}
      }
    },
    "hard_failures": {
      "type": "array",
      "items": {"type": "string"}
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "category", "location", "finding", "source_evidence", "required_change"],
        "properties": {
          "severity": {"type": "string", "enum": ["blocker", "major", "minor"]},
          "category": {"type": "string"},
          "location": {"type": "string"},
          "finding": {"type": "string"},
          "source_evidence": {"type": "string"},
          "required_change": {"type": "string"}
        }
      }
    },
    "strengths": {
      "type": "array",
      "items": {"type": "string"}
    },
    "revision_priority": {
      "type": "array",
      "items": {"type": "string"}
    },
    "summary": {"type": "string"}
  }
}
