# Jenkins 流水线专用配置模板。
# 将本文件复制到 Agent 主机的 D:/API_CASE/.env.pipeline，并填写真实值。
# Jenkins 会把它复制到 workspace；不要提交真实 .env.pipeline。

USE_CHINA_ENVIRONMENT=TRUE

CHINA_TEST_ENVIRONMENT_BASE_URL=https://pre.juhemoxing.com
CHINA_API_KEY=your-china-api-key
CHINA_CONTROL_API_KEY=your-china-control-api-key

OVERSEAS_TEST_BASE_URL=https://pre.tokensave.pro
OVERSEAS_API_KEY=your-overseas-api-key
OVERSEAS_CONTROL_API_KEY=your-overseas-control-api-key

B_ACCOUNT_API_KEY=your-b-account-api-key
B_ACCOUNT_CONTROL_KEY=your-b-account-control-key
ZERO_BALANCE_API_KEY=your-zero-balance-api-key
ZERO_BALANCE_CONTROL_KEY=your-zero-balance-control-key

API_TIMEOUT=600

GENERATE_ALLURE_REPORT=FALSE
GENERATE_HISTORY_REPORT=FALSE
HISTORY_REPORT_KEEP_LIMIT=30
GENERATE_PIPELINE_SUMMARY=TRUE

# Jenkins Real Smoke 会显式开启 Quality、Semantic、Metrics 和状态评估。
QUALITY_ENABLE=0
QUALITY_SEMANTIC_ENABLE=0
QUALITY_METRICS_ENABLE=0
QUALITY_FLAKY_HISTORY_ENABLE=0
QUALITY_FLAKY_STATE_ENABLE=0
QUALITY_FLAKY_DB_PATH=D:/API_CASE_DATA/jenkins/api-case/flaky.sqlite3
